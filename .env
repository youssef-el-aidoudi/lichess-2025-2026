# ===== Global =====
TZ=Europe/Paris

# ===== PostgreSQL =====
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres-STRONG!

# ===== RabbitMQ (utilisé par producer/worker) =====
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-STRONG!

# ===== MinIO =====
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-STRONG!
# URL vue par les apps (change en prod derrière ton reverse-proxy)
MINIO_SERVER_URL=http://minio:9000

# ===== Apps Spring Boot (backend, etl, worker, producer) =====
SPRING_PROFILES_ACTIVE=prod
