# ===== PostgreSQL =====
POSTGRES_DB=chessmate
POSTGRES_USER=chessmate
POSTGRES_PASSWORD=change-me-postgres-STRONG!

# ===== RabbitMQ (utilisé par producer/worker) =====
RABBITMQ_DEFAULT_USER=chessmate
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-STRONG!

# ===== MinIO =====
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin


MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

MINIO_SERVER_URL=http://minio:9000
BACKEND_HOST=api.docker.localhost
MINIO_HOST=minio.docker.localhost
TRAEFIK_HOST=traefik.docker.localhost

# ===== Apps Spring Boot (backend, etl, worker, producer) =====
SPRING_PROFILES_ACTIVE=prod
